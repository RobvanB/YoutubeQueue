<%# Copilot-authored: Begin video library filters and compact table. %>
<% provide(:title, "Videos") %>

<section class="video-library" data-video-library data-save-filter-url="<%= save_video_filter_path %>">
  <h1>Videos</h1>

  <div class="library-filters" role="search">
    <label class="search-field">
      <span class="visually-hidden">Search videos</span>
      <input type="search" placeholder="Search..." data-video-search>
    </label>

    <label class="select-field">
      <span class="visually-hidden">Filter by channel</span>
      <select data-channel-filter>
        <option value="">All channels</option>
        <% @channels.each do |channel| %>
          <option value="<%= channel %>" <%= "selected" if channel == @selected_channel %>><%= channel %></option>
        <% end %>
      </select>
    </label>

    <label class="select-field">
      <span class="visually-hidden">Filter by watched</span>
      <select data-watched-filter>
        <option value="all" <%= "selected" if @selected_watched == "all" %>>All</option>
        <option value="unwatched" <%= "selected" if @selected_watched == "unwatched" %>>No</option>
        <option value="watched" <%= "selected" if @selected_watched == "watched" %>>Yes</option>
      </select>
    </label>
  </div>

  <div class="video-table-wrap">
    <table class="video-table">
      <thead>
        <tr>
          <th scope="col">Channel</th>
          <th scope="col">Date Published</th>
          <th scope="col">Title</th>
          <th scope="col">Watch</th>
          <th scope="col">Watched</th>
          <th scope="col">Set Watched</th>
          <th scope="col">Edit</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "video", collection: @videos, as: :video %>
      </tbody>
    </table>
  </div>

  <p>
    Click <%= link_to "here", "https://www.youtube.com/terms", target: "_blank", rel: "noopener noreferrer" %>
    for YouTube TOS that apparently is mandatory even on a site that is for personal use only.
  </p>
</section>
<%# Copilot-authored: End video library filters and compact table. %>
