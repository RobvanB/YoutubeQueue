<!DOCTYPE html>
<!-- Copilot-authored: Begin modern shared application layout. -->
<html>
  <head>
    <title><%= yield(:title) %> | YouTube Queue</title>
    <%= csp_meta_tag %>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "application", media: "all", "data-turbolinks-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbolinks-track": "reload" %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to "YouTube Queue", videos_path, class: "brand" %>

        <nav class="site-nav" aria-label="Main navigation">
          <%= link_to "Home", videos_path, class: "site-nav__link #{controller_name == 'videos' ? 'is-active' : ''}" %>
          <%= link_to "Load latest videos", pull_path, class: "site-nav__link" %>
          <%= link_to "Check/set last date", ytq_params_path, class: "site-nav__link #{controller_name == 'ytq_params' ? 'is-active' : ''}" %>
          <%= link_to "Delete watched videos", delete_watched_videos_path, method: :delete, class: "button button--danger", data: { confirm: "Delete all videos marked as watched?" } %>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <% if notice.present? %>
        <div class="flash-message flash-message--notice" role="status"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="flash-message flash-message--alert" role="alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
<!-- Copilot-authored: End modern shared application layout. -->
